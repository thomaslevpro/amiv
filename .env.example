VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog browser analytics.
VITE_POSTHOG_KEY=
# Use https://eu.i.posthog.com for an EU PostHog project.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional: set to true locally only when you intentionally want dev analytics events.
VITE_POSTHOG_CAPTURE_IN_DEVELOPMENT=false

# Sentry browser error tracking.
VITE_SENTRY_DSN=

# Sentry source map upload for Vercel builds only. Do not expose these as VITE_* variables.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
